FROM python:3.14-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY --from=portal /pyproject.toml /README.md ./
COPY --from=portal /src ./src

RUN python -m pip install --upgrade pip \
    && python -m pip install .

EXPOSE 8001

CMD ["python", "-m", "mcp_portal", "--production", "--transport", "streamable-http", "--host", "0.0.0.0", "--port", "8001", "--path", "/mcp", "--no-banner"]
