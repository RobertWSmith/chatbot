SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/langgraph_chat
LANGGRAPH_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/langgraph_chat?sslmode=disable
OPENAI_API_KEY=
CHAT_MODEL_PROVIDER=openai
CUSTOM_REASONING_GRAPH_ENABLED=1
DEFAULT_MODEL=gpt-5.5
DEFAULT_REASONING_EFFORT=medium
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_EMBEDDING_DIMENSIONS=1536
CONVERSATION_HISTORY_LIMIT=24
PLATFORM_ADMIN_EMAILS=admin@example.com
# Add each MCP bearer token under the environment variable named by its namespace record.
# BILLING_MCP_TOKEN=
FLASK_DEBUG=1
